---
import Layout from '../../../layouts/Layout.astro';
import BrowseSongGrid from '../../../components/BrowseSongGrid.astro';
import BrowseOccasionGuides from '../../../components/BrowseOccasionGuides.astro';
import BrowseBlogGuides from '../../../components/BrowseBlogGuides.astro';
import { songs } from '../../../lib/songs';
import { getThemeDescription } from '../../../lib/themeDescriptions';
import { slugifyBrowseValue } from '../../../lib/browseSlugs';
import { getBrowseOccasionGuides } from '../../../lib/browseOccasionGuides';
import { getBrowseBlogGuides } from '../../../lib/browseBlogGuides';
import editorialsData from '../../../../public/browse-editorials.json';
import { marked } from 'marked';
import catalogIntegrity from '../../../data/catalogIntegrity.json';
import songRedirects from '../../../data/songRedirects.json';

export async function getStaticPaths() {
  const allThemes = new Set<string>();
  
  songs.forEach(song => {
    song.themes?.forEach(theme => {
      allThemes.add(slugifyBrowseValue(theme));
    });
  });

  return Array.from(allThemes).map(theme => ({
    params: { theme },
    props: { theme }
  }));
}

const { theme: themeProp } = Astro.props;
const themeSlug = Astro.params.theme;
const themeDescription = getThemeDescription(themeSlug);

// Bounded integrity pass for the collections reviewed in October16, October19, and the Prayer and refuge release.
// Keep quarantined/deleted/retired song entries out of their recommendations.
const reviewedTheme = ['obedience', 'transformation', 'borders', 'covenant', 'consecration', 'justification', 'protection', 'cleansing', 'intercession'].includes(themeSlug);
const hiddenSongs = new Set([...catalogIntegrity.quarantined, ...catalogIntegrity.deleted, ...Object.keys(songRedirects)]);

// Normalize theme for comparison
const normalizedTheme = themeSlug.replace(/-/g, ' ');
const filteredSongs = songs
  .filter(s => 
    s.themes?.some(t => slugifyBrowseValue(t) === themeSlug) && (!reviewedTheme || !hiddenSongs.has(s.slug))
  )
  .sort((a, b) => a.title.localeCompare(b.title));

// Format theme name for display
const displayTheme = themeSlug
  .split('-')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

const title = `Worship Songs About ${displayTheme} | Worship Song Index`;
const editorialEntry = (editorialsData as any)["themes"]?.[themeSlug || ''];
const prayerRefugeTheme = ['protection', 'cleansing', 'intercession'].includes(themeSlug);
const description = prayerRefugeTheme ? editorialEntry.description : themeSlug === 'borders' ? 'Browse the current Borders song entry and related kingdom and immigration collections. Review song context before choosing music for your service.' : `Browse ${filteredSongs.length} worship songs about ${normalizedTheme}, with complete song data, BPM, keys, and theological insights for every song.`;

const editorialHtml = editorialEntry?.editorial_markdown ? marked.parse(editorialEntry.editorial_markdown) : null;
const occasionGuides = await getBrowseOccasionGuides('themes', themeSlug);
const blogGuides = getBrowseBlogGuides('themes', themeSlug);

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Worship Songs About ${displayTheme}`,
  "description": prayerRefugeTheme ? description : `${filteredSongs.length} worship songs on the theme of ${normalizedTheme}, with keys, BPM, and tempo for each.`,
  "numberOfItems": filteredSongs.length,
  "itemListElement": filteredSongs.slice(0, 30).map((song, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://worshipsongindex.com/songs/${song.slug}`,
    "name": song.title
  }))
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://worshipsongindex.com" },
    { "@type": "ListItem", "position": 2, "name": "Browse", "item": "https://worshipsongindex.com/browse" },
    { "@type": "ListItem", "position": 3, "name": "Categories", "item": "https://worshipsongindex.com/browse/categories" },
    { "@type": "ListItem", "position": 4, "name": displayTheme, "item": `https://worshipsongindex.com${Astro.url.pathname}` }
  ]
};

const structuredData = [itemList, breadcrumb];
---

<Layout title={title} description={description} structuredData={structuredData}>
  <nav class="mb-8 text-sm" style="color: var(--color-text-muted);">
    <a href="/" class="text-primary-600 hover:text-primary-800 transition-colors">Home</a>
    <span class="mx-2">/</span>
    <a href="/browse" class="text-primary-600 hover:text-primary-800 transition-colors">Browse</a>
    <span class="mx-2">/</span>
    <a href="/browse/categories" class="text-primary-600 hover:text-primary-800 transition-colors">Categories</a>
    <span class="mx-2">/</span>
    <span>Theme: {displayTheme}</span>
  </nav>

  <div class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-text-primary);">
      Theme: {displayTheme}
    </h1>
    <p style="color: var(--color-text-muted);">Showing {filteredSongs.length} songs</p>
  </div>

  {themeDescription && (
    <div class="mb-8 max-w-3xl">
      <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
        {themeDescription}
      </p>
    </div>
  )}

  {themeSlug === 'borders' && (
    <div class="mb-8 max-w-3xl space-y-3" style="color: var(--color-text-secondary);">
      <p>This collection currently contains one catalog entry. Open its song page to review the context before including it in a service.</p>
      <p>For a broader selection, browse <a href="/browse/themes/kingdom/" class="text-primary-600 underline">kingdom songs</a> or <a href="/browse/themes/immigration/" class="text-primary-600 underline">immigration songs</a>, or compare other <a href="/browse/artists/propaganda/" class="text-primary-600 underline">Propaganda songs</a>.</p>
    </div>
  )}

  {editorialHtml && (
    <article class="mb-12 max-w-3xl prose prose-lg" style="color: var(--color-text-secondary);" set:html={editorialHtml} />
  )}

  {occasionGuides.length > 0 && (
    <BrowseOccasionGuides guides={occasionGuides} />
  )}

  {blogGuides.length > 0 && (
    <BrowseBlogGuides guides={blogGuides} />
  )}

  <BrowseSongGrid songs={filteredSongs} />
</Layout>
