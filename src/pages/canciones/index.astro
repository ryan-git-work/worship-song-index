---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { spanishSongs } from '../../lib/songs';
import { formatTheme } from '../../types/song';

const browsePages = await getCollection('spanishBrowsePages');
const themePages = browsePages
  .filter((entry) => entry.data.url.startsWith('/canciones/temas/'))
  .sort((left, right) => left.data.slug.localeCompare(right.data.slug, 'es'));
const artistPages = browsePages
  .filter((entry) => entry.data.url.startsWith('/canciones/artistas/'))
  .sort((left, right) => left.data.slug.localeCompare(right.data.slug, 'es'));
const sortedSongs = [...spanishSongs].sort((left, right) => left.title.localeCompare(right.title, 'es'));

function artistToSlug(artist: string): string {
  return artist
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[\/\\]/g, '-')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

function countTheme(slug: string): number {
  return spanishSongs.filter((song) => song.themes.includes(slug)).length;
}

function countArtist(slug: string): number {
  return spanishSongs.filter((song) => song.cluster === slug || artistToSlug(song.primary_artist) === slug).length;
}

const title = 'Canciones de adoración en español | Worship Song Index';
const description = 'Índice editorial de canciones de adoración en español: qué significa cada canción, dónde encaja en el servicio y cómo dirigirla. Temas, artistas y catálogo completo.';
const canonicalURL = 'https://worshipsongindex.com/canciones/';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonicalURL,
  inLanguage: 'es',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: spanishSongs.length,
    itemListElement: sortedSongs.slice(0, 20).map((song, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: song.title,
      url: `https://worshipsongindex.com/canciones/${song.slug}/`,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://worshipsongindex.com' },
    { '@type': 'ListItem', position: 2, name: 'Canciones', item: canonicalURL },
  ],
};
---

<Layout title={title} description={description} structuredData={[collectionSchema, breadcrumbSchema]} lang="es">
  <nav class="mb-8 text-sm" style="color: var(--color-text-muted);">
    <a href="/" class="text-primary-600 hover:text-primary-800 transition-colors">Home</a>
    <span class="mx-2">/</span>
    <span>Canciones</span>
  </nav>

  <header class="max-w-4xl mb-12">
    <p class="text-sm font-medium uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
      Índice en español
    </p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-5" style="font-family: var(--font-serif); color: var(--color-text-primary);">
      Canciones de adoración en español
    </h1>
    <div class="prose prose-lg max-w-none" style="color: var(--color-text-secondary);">
      <p>
        Cada canción de este índice tiene su propia página: qué significa, qué hace en la congregación, dónde encaja en el servicio y cómo enseñarla a tu equipo. No hay letras ni acordes aquí. Hay contexto pastoral y teológico para elegir bien lo que tu iglesia canta.
      </p>
      <p>
        El catálogo cubre el repertorio que las congregaciones hispanohablantes cantan de verdad, desde los himnos que llevan generaciones en la memoria de la iglesia hasta la adoración contemporánea de Miel San Marcos, Marcos Witt, Christine D'Clario, Marcos Brunet, Un Corazón, Generación 12 y versiones oficiales en español.
      </p>
      <p>
        Empieza por un tema si estás armando un set, por un artista si tu congregación ya tiene un lenguaje musical definido, o busca la canción directamente en el catálogo completo.
      </p>
    </div>
  </header>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-5" style="font-family: var(--font-serif); color: var(--color-text-primary);">Explora por tema</h2>
    <div class="grid gap-3 md:grid-cols-3">
      {themePages.map((entry) => (
        <a href={entry.data.url} class="rounded-lg border p-4 transition-colors hover:bg-primary-50" style="border-color: var(--color-border);">
          <h3 class="font-semibold" style="color: var(--color-text-primary);">{formatTheme(entry.data.slug)}</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{countTheme(entry.data.slug)} canciones</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-5" style="font-family: var(--font-serif); color: var(--color-text-primary);">Explora por artista</h2>
    <div class="grid gap-3 md:grid-cols-3">
      {artistPages.map((entry) => (
        <a href={entry.data.url} class="rounded-lg border p-4 transition-colors hover:bg-primary-50" style="border-color: var(--color-border);">
          <h3 class="font-semibold" style="color: var(--color-text-primary);">{entry.data.meta_title.replace('Canciones de ', '').replace(' | Worship Song Index', '')}</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{countArtist(entry.data.slug)} canciones</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-5" style="font-family: var(--font-serif); color: var(--color-text-primary);">Catálogo completo</h2>
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      {sortedSongs.map((song) => (
        <a href={`/canciones/${song.slug}/`} class="rounded-lg border p-4 transition-colors hover:bg-primary-50" style="border-color: var(--color-border);">
          <h3 class="font-semibold" style="color: var(--color-text-primary);">{song.title}</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{song.primary_artist}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
